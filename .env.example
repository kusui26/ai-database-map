# AI Database Map — 環境変数テンプレート
#
# 実値は .env（.gitignore 済み）に記入する。本ファイルには秘密情報を書かない。
# 各変数がどのフェーズで必要になるかを併記する（P0 時点では未使用）。

# --- パイプライン（データ生成 / P1・P2b） ---
# e-Stat（政府統計の総合窓口）API の appId
ESTAT_APP_ID=

# --- 地図（アプリ / P4a） ---
# ベースマップのスタイル URL。未指定なら国土地理院 最適化ベクトルタイルの既定を使う。
NEXT_PUBLIC_MAP_STYLE_URL=

# --- サイト（アプリ / P7a） ---
# 本番の絶対 URL。OG 画像・canonical の基点（未指定時は Vercel 本番URL→localhost へフォールバック）。
NEXT_PUBLIC_SITE_URL=

# --- Supabase（DB / P2a 以降） ---
# プロジェクト URL と anon キー（ブラウザ公開可・RLS で読み取りに限定）
SUPABASE_URL=
SUPABASE_ANON_KEY=
# サービスロールキー（サーバ専用・絶対に公開しない。投入/管理用）
SUPABASE_SERVICE_ROLE_KEY=
# 直結接続文字列（psycopg での一括投入用・サーバ/ローカルのみ）
SUPABASE_DB_URL=

# --- データセット署名 URL（build_dataset / PR-5・サーバ専用） ---
# CSV ダウンロード URL の HMAC 署名鍵。本番必須（例: openssl rand -hex 32 で生成）。
# 未設定だと本番の build_dataset が失敗する（開発は固定の代替鍵で動く）。
DATASET_URL_SECRET=

# --- LLM（Step2 / P8a 以降・サーバ専用） ---
GEMINI_API_KEY=
# 使用モデル（未指定なら既定 gemini-flash-lite-latest＝無料枠で実用的・高速）。
# 品質重視/本番は有料枠 or Vertex で gemini-flash-latest / gemini-3-flash-preview 等に切替（docs/p8c_eval_report.md）
GEMINI_MODEL=
