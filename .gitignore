# --- 指定の除外フォルダ ---
data/
slide/
# ハッカソンの参照資料（週報・キックオフ資料）。社内へ説明した内容を含み、
# キックオフ資料は 11MB あるため、公開リポジトリには入れない（entry.md だけを管理する）。
tokyo_hackathon/references/
# 応募フォームに貼るスクリーンショット（1枚 1MB 前後）。提出時にしか使わないので追跡しない。
tokyo_hackathon/images/
# 提出するプレゼン資料の本体（PowerPoint・PDF）。Google Drive で管理していて
# pptx は 8MB あるため、リポジトリには構成案（presentation.md）だけを置く。
tokyo_hackathon/*.pptx
tokyo_hackathon/*.pdf

# --- macOS ---
.DS_Store

# --- Python ---
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/
  
# --- 環境変数・機密情報（APIキー等） ---
.env
.env.*
!.env.example
*.key
  
# --- ログ・一時ファイル ---
*.log
*.tmp

# --- Node / Next.js（アプリ） ---
node_modules/
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo
.eslintcache

# --- テスト・カバレッジ ---
coverage/

# --- Vercel ---
.vercel/